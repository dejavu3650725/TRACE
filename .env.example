# ── TRACE 환경 변수 견본 ─────────────────────────────────
# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요. (.env는 커밋 금지)

# Supabase — 브라우저에서도 쓰는 공개 설정 (NEXT_PUBLIC_ 필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — 서버 전용 별칭 (위와 같은 값)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 해커톤 Demo seed 전용. 서버/로컬 스크립트에서만 사용하며 브라우저에 노출 금지
# a1~a3 누적 데이터 준비가 끝나면 .env에서 제거하거나 키를 교체하세요.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (Gemini) — 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
# Provider 교체 분기는 서버 전용 VLM Adapter 한 곳에서만 처리
AI_PROVIDER=gemini
GEMINI_API_KEY=
# 사용할 Gemini 모델 (선택, 기본값 gemini-3.6-flash)
GEMINI_MODEL=

# Upstage — PDF/이미지 우선 Provider, 실패 시 Gemini fallback (선택)
# 미디어가 없는 텍스트 요청은 Gemini 우선, Upstage fallback
# PDF/이미지는 Document Parse 후 Solar가 기존 JSON 계약으로 정리
UPSTAGE_API_KEY=
# 사용할 Upstage Solar 모델 (선택, 기본값 solar-pro4)
UPSTAGE_MODEL=solar-pro4

# 개발 편의: Google OAuth 설정 전까지 true, 설정 후 false로 변경
NEXT_PUBLIC_AUTH_BYPASS=true

# Supabase Admin — 학생 공개 제출(QR) 서버 전용 키. 절대 NEXT_PUBLIC_ 금지
SUPABASE_SERVICE_ROLE_KEY=
